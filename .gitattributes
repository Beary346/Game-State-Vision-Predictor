# Normalize line endings: files are authored on Windows but stored in git as LF.
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.sh    text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf